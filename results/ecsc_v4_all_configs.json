    {
      "version": "v4.2",
      "description": "Dual-L with per-target eligibility, baseline/spike decomposition, anchor specificity",
      "model": {
        "name": "mistralai/Mistral-7B-v0.1",
        "display": "Mistral-7B-v0.1",
        "tag": "mistral7b",
        "quantization": "4bit-nf4"
      },
      "params": {
        "MIN_WORDS": 200,
        "K_TARGETS": 20,
        "TARGET_START_FRAC": 0.15,
        "TARGET_END_FRAC": 0.90,
        "TARGET_REGION_TOKENS": 40,
        "SHORT_CONTEXT": 32,
        "LONG_CONTEXTS": [512, 256],
        "CONTEXT_GRID_BURST": [32, 64, 128, 192, 256, 384, 512],
        "SPIKE_PERCENTILE": 95,
        "SPIKE_MASS_TOP_FRAC": 0.10,
        "MIN_TARGETS_PER_DOC": 8,
        "MIN_TARGETS_512": 4,
        "MAX_CONTEXT_FIXED": 512,
        "N_BOOTSTRAP": 1000
      },
      "notes": "Per-target eligibility: lo=max(0.15*T, L), hi=min(0.9*T, T-40)"
    },
    {
      "version": "v4.2",
      "description": "Robustness check with larger model",
      "model": {
        "name": "Qwen/Qwen2.5-7B-Instruct",
